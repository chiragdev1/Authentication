# the only thing on the internet. the nginx image fills in ${API_DOMAIN} at startup (only variables set in the
# environment are replaced, so nginx's own $host, $remote_addr... are left alone). certificates come from the certbot container

# docker's dns. resolving the gateway per request (through the variable below) means a restarted gateway with a new
# address doesn't leave nginx sending to the old one, and nginx can start before the gateway is up
resolver 127.0.0.11 valid=10s ipv6=off;

server_tokens off;

# requests for any other hostname, or by bare ip, are dropped instead of reaching the api
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    # let's encrypt checks this path over plain http when the certificate is renewed
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # nginx refuses bodies over 1 MB by default, below the 2 MB avatar limit. the services enforce the real limits
    # (50 KB json, 2 MB avatar) and answer in the api's json shape; this only stops anything far larger early
    client_max_body_size 3m;

    location / {
        set $gateway http://gateway:9000;
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # overwritten, never appended to ($proxy_add_x_forwarded_for): the services trust this hop because of TRUST_PROXY=1,
        # so a client-sent X-Forwarded-For passed through would let anyone pick their own ip and dodge the rate limits
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # the gateway gives up on a service after 30 seconds, so this only fires if the gateway itself hangs
        proxy_read_timeout 60s;
    }
}
