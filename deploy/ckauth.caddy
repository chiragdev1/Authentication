# CKAuth site, copied to /opt/edge/sites/ckauth.caddy by every deploy
# ckauth-api and ckauth-web are network aliases on the shared `edge` network (see deploy/compose.yml)
ckauth.chiragdev.com {
	encode zstd gzip

	# /api/auth/sign-in -> ckauth-api:8080/auth/sign-in, same rewrite as the vite dev proxy
	handle_path /api/* {
		reverse_proxy ckauth-api:8080 {
			# idle upstream connections close well before node's keepAliveTimeout (125 s), so caddy never reuses a dead one
			transport http {
				keepalive 60s
			}
		}
	}

	# everything else is the SPA; the web container sets cache headers and the index.html fallback
	handle {
		reverse_proxy ckauth-web:8080 {
			# same idea: close idle connections before the web container's own idle timeout (5 min) does
			transport http {
				keepalive 60s
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# email links carry tokens in the query string; never leak them to other sites
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# avatars are served from imagekit; everything else is same-origin. the one inline script is the theme script
		# (frontend/public/theme-init.js), allowed by its hash; frontend's build fails if the hash is stale
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://ik.imagekit.io; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-jz767lDpfSctHKI30WlmhVXmEec4TZVh3nx1B0CVeDo='; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
