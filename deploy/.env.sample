# production settings for deploy/compose.yml: copy to deploy/.env (gitignored) on the server and fill in.
# compose reads this file itself (for the ${...} values) and passes it to every node service.
# infrastructure values (service urls, REDIS_URL, NODE_ENV, TRUST_PROXY, SERVICE_HOST) are set in compose.yml, not here.
# generate secrets with: openssl rand -hex 32   (hex, so they are safe inside urls)

# hostnames, without https://. both must be under the same registrable domain, because the auth cookies are SameSite=Lax
API_DOMAIN=api.auth.example.com
FRONTEND_DOMAIN=auth.example.com

POSTGRES_PASSWORD=change-me

INTERNAL_API_KEY=change-me-at-least-32-characters
ACCESS_TOKEN_SECRET_KEY=change-me-at-least-32-characters
REFRESH_TOKEN_SECRET_KEY=change-me-at-least-32-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# the api has its own hostname in production, so its cookies can't collide with another app's
COOKIE_PREFIX=

APP_NAME=YourApp
RESEND_API_KEY=re_your_resend_api_key
# the domain must be verified in Resend (SPF and DKIM records in your DNS)
EMAIL_FROM="Your App <no-reply@example.com>"
EMAIL_CONCURRENCY=5

IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_FOLDER=/avatars
