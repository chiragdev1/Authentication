# /opt/ckauth/api.env : settings and secrets for the CKAuth api container
# copy this whole file to the VPS, fill in every empty value, then: chmod 660 api.env
# DATABASE_URL, FRONTEND_URL, NODE_ENV and PORT are set by compose.yml, don't add them here
# after editing this file on the VPS: cd /opt/ckauth && docker compose up -d api

# ---- sessions --------------------------------------------------------------
# two DIFFERENT long random values; generate each with: openssl rand -hex 64
# changing either one signs every user out
ACCESS_TOKEN_SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=
# how long a sign-in lasts before a silent refresh (access) and before signing in again (refresh)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ---- email (Resend) --------------------------------------------------------
# product name used in email subjects and bodies
APP_NAME=CKAuth
# api key from https://resend.com/api-keys (starts with re_); "Sending access" is enough
RESEND_API_KEY=
# sender address; its domain MUST be verified at https://resend.com/domains
# moving to another mail domain = verify the new domain in Resend, change only this line, restart the api
# (see "Changing the email domain" in docs/DEPLOYMENT.md)
EMAIL_FROM=CKAuth <no-reply@yourdomain.com>

# ---- avatars (ImageKit) ----------------------------------------------------
# private key from https://imagekit.io/dashboard/developer/api-keys (starts with private_)
# leave empty to run without avatar uploads; everything else still works
IMAGEKIT_PRIVATE_KEY=
