PORT=8080

# development | production (production makes auth cookies secure-only)
NODE_ENV=development

# matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authentication-with-typescript

# jwt secrets, use long random values and different ones for each
# generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET_KEY=your-access-token-secret
REFRESH_TOKEN_SECRET_KEY=your-refresh-token-secret

# jwt token expiry (e.g. 15m, 1h, 7d)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=1d

# app name shown in emails
APP_NAME=YourApp

# email (Resend)
# api key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=re_your_resend_api_key
# sender address, must be on your Resend-verified domain
EMAIL_FROM="Your App <no-reply@yourdomain.com>"

# frontend base url used in email links
FRONTEND_URL=http://localhost:3000

# ImageKit (avatar uploads)
# private key from https://imagekit.io/dashboard/developer/api-keys (starts with private_)
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
