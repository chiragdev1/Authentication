# environment for the microservice-architecture branch: copy to .env.microservices (gitignored).
# it is separate from .env so this trial never touches the main app's database, ports or secrets.
# every service reads this one file and validates only the variables it uses

# development | production (production makes auth cookies secure-only)
NODE_ENV=development

# the gateway is the only public port; the services listen on SERVICE_HOST (127.0.0.1 by default)
GATEWAY_PORT=9000
AUTH_SERVICE_PORT=9001
MEDIA_SERVICE_PORT=9002
AUTH_SERVICE_URL=http://127.0.0.1:9001
MEDIA_SERVICE_URL=http://127.0.0.1:9002

# shared secret the gateway adds to every forwarded request and services send to each other (at least 32 characters)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=your-internal-api-key

# own postgres container from docker-compose.yml (port 5433; main uses 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth_microservices

# email queue and rate limit counts, in this branch's own redis container (port 6380; main uses 6379)
REDIS_URL=redis://localhost:6380

# jwt secrets, use long random values and different ones for each (and different from main's)
# generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET_KEY=your-access-token-secret
REFRESH_TOKEN_SECRET_KEY=your-refresh-token-secret

# jwt token expiry (e.g. 15m, 1h, 7d); the refresh expiry is also how long a session lasts without use
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# app name shown in emails
APP_NAME=YourApp

# email (Resend), used by notification-service
# api key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=re_your_resend_api_key
# sender address, must be on a domain this Resend key may send from
EMAIL_FROM="Your App <no-reply@yourdomain.com>"
# emails sent at the same time
EMAIL_CONCURRENCY=5

# frontend base url, used in email links and as the only allowed CORS origin (required in production)
# prefix for the auth cookie names. browsers share cookies across ports, so without it signing in on this app (localhost:9000)
# would overwrite the main app's cookies (localhost:8080) and sign you out there
COOKIE_PREFIX=ms_

FRONTEND_URL=http://localhost:3000

# ImageKit (avatar uploads), used by media-service
# private key from https://imagekit.io/dashboard/developer/api-keys (starts with private_)
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_FOLDER=/avatars-microservices

# number of reverse proxies in front of the gateway (0 when it is exposed directly); services add one for the gateway
TRUST_PROXY=0
