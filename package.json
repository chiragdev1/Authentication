{
  "name": "authentication-microservices",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @authentication/shared build && pnpm -r --parallel dev",
    "start": "pnpm -r --parallel start",
    "test": "pnpm --filter @authentication/shared build && pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:create": "pnpm --filter @authentication/auth-service db:create",
    "db:generate": "pnpm --filter @authentication/auth-service db:generate",
    "db:migrate": "pnpm --filter @authentication/auth-service db:migrate",
    "drizzle:studio": "pnpm --filter @authentication/auth-service drizzle:studio"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
